<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkTreeMemo.App.ViewModels"
             xmlns:models="clr-namespace:WorkTreeMemo.Core.Models;assembly=WorkTreeMemo.Core"
             x:Class="WorkTreeMemo.App.Views.SettingsView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <!-- ══ Scan roots ═══════════════════════════════════════════ -->
            <Border Classes="card" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Text[ScanRoots]}" Classes="heading" />
                        <TextBlock Text="{Binding Text[ScanRootsHint]}" Classes="muted" FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10" Padding="6"
                            MinHeight="120">
                        <Panel>
                            <TextBlock Text="{Binding Text[NoRoots]}" Classes="faint" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasRoots}" />
                            <ListBox Classes="nav" ItemsSource="{Binding Roots}"
                                     SelectedItem="{Binding SelectedRoot}"
                                     IsVisible="{Binding HasRoots}" MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:ScanRoot">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Path}" Classes="mono" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Path}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="badge">
                                                <TextBlock Text="{Binding MaxDepth}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Panel>
                    </Border>

                    <Grid ColumnDefinitions="*,96,Auto,Auto" ColumnSpacing="10">
                        <TextBox Watermark="{Binding Text[FolderPath]}" Text="{Binding NewRootPath}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding NewRootDepth}" Minimum="0" Maximum="10"
                                       Increment="1" FormatString="0" ToolTip.Tip="{Binding Text[Depth]}" />
                        <Button Grid.Column="2" Content="{Binding Text[ChooseFolder]}" Click="ChooseFolder" />
                        <Button Grid.Column="3" Classes="primary" Content="{Binding Text[AddRoot]}"
                                Command="{Binding AddRootCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding RootCountText}" Classes="faint" FontSize="13"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding Text[RemoveRoot]}"
                                Command="{Binding RemoveRootCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Branch age cutoff ════════════════════════════════════ -->
            <Border Classes="card" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Text[BranchAge]}" Classes="heading" />
                            <TextBlock Text="{Binding Text[BranchAgeHint]}" Classes="muted" FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <NumericUpDown Value="{Binding IgnoreBranchesOlderThanDays}" Minimum="0" Maximum="3650"
                                           Increment="30" FormatString="0" Width="126" />
                            <TextBlock Text="{Binding Text[Days]}" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding BranchCutoffSummary}" Classes="faint" FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ══ Appearance ═══════════════════════════════════════════ -->
            <Border Classes="card" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Text[SavedViews]}" Classes="heading" />
                    <ComboBox ItemsSource="{Binding SavedViews}" SelectedItem="{Binding SelectedSavedView}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:SavedView"><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding NewSavedViewName}" Watermark="{Binding Text[SavedViewName]}" />
                        <Button Grid.Column="1" Content="{Binding Text[SaveView]}" Command="{Binding SaveViewCommand}" />
                        <Button Grid.Column="2" Classes="primary" Content="{Binding Text[ApplyView]}" Command="{Binding ApplyViewCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Appearance ═══════════════════════════════════════════ -->
            <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Text[Appearance]}" Classes="heading" />
                        <TextBlock Text="{Binding Text[ThemeHint]}" Classes="muted" FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="segment" VerticalAlignment="Center">
                        <UniformGrid Columns="2">
                            <RadioButton Classes="segment" Content="{Binding Text[ThemeLight]}"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                            <RadioButton Classes="segment" Content="{Binding Text[ThemeDark]}"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Text[LocalGitOnly]}" Classes="faint" FontSize="12" Margin="4,0,0,8"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
