<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkTreeMemo.App.ViewModels"
             x:Class="WorkTreeMemo.App.Views.AboutView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
            <Border Classes="card" Padding="24">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="WorkTreeMemo" Classes="title" />
                        <TextBlock Text="{Binding Text[Tagline]}" Classes="muted" FontSize="14" />
                    </StackPanel>
                    <Rectangle Classes="rule" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                        <TextBlock Text="{Binding Text[Version]}" Classes="faint" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{Binding Text[License]}" Classes="faint" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="{Binding Text[Author]}" Classes="faint" VerticalAlignment="Center" />
                        <Button Grid.Row="2" Grid.Column="1" Classes="ghost" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Padding="0" MinHeight="0"
                                Content="Mehmet Can Kanpolat (MCKanpolat)"
                                Tag="https://github.com/MCKanpolat" Click="OpenWebPage" />
                        <TextBlock Grid.Row="3" Text="{Binding Text[RepositoryUrl]}" Classes="faint" VerticalAlignment="Center" />
                        <Button Grid.Row="3" Grid.Column="1" Classes="ghost" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Padding="0" MinHeight="0"
                                Content="github.com/MCKanpolat/WorkTreeMemo"
                                Tag="https://github.com/MCKanpolat/WorkTreeMemo" Click="OpenWebPage" />
                    </Grid>
                    <TextBlock Text="{Binding Text[AboutDescription]}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Text[Updates]}" Classes="heading" />
                    <TextBlock Text="{Binding UpdateCheckStatus}" Classes="muted" FontSize="13"
                               TextWrapping="Wrap" IsVisible="{Binding !IsCheckingForUpdates}" />
                    <Button Classes="primary" Content="{Binding Text[CheckForUpdates]}"
                            HorizontalAlignment="Left" Command="{Binding CheckForUpdatesCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
